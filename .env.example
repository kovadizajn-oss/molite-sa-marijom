# Kopiraj ovaj fajl u .env za lokalni rad (.env se NE sprema na GitHub) i/ili
# unesi iste varijable u Vercel Project Settings -> Environment Variables.

# Supabase -> Project Settings -> Database -> Connection string (Connection pooling / "Transaction" mode)
DATABASE_URL=postgresql://postgres:LOZINKA@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Supabase -> Project Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_BUCKET=uploads

# Supabase -> Project Settings -> API -> "anon" / "publishable" ključ (NIJE tajna,
# smije biti javan u pregledniku). Koristi se samo za izravan upload velikih PDF-ova
# iz admin panela izravno u Supabase, mimo Vercelovog ograničenja od 4.5MB po zahtjevu.
SUPABASE_ANON_KEY=eyJ...

# Bilo koji dugačak nasumičan niz znakova (za potpisivanje admin prijave)
JWT_SECRET=promijeni-ovu-tajnu-u-produkciji

# Početni admin račun (koristi se samo prvi put, kad je baza prazna)
ADMIN_INITIAL_USERNAME=marija
ADMIN_INITIAL_PASSWORD=molitva123

NODE_ENV=production
